# ==============================================================================
# Configuración de Steam Trades & Keys Valuation
# ==============================================================================

# Ruta persistente de datos (base de datos SQLite)
# - En Raspberry Pi / DietPi: /mnt/dietpi_userdata/apps/steamtrades/data
# - En desarrollo local (PC): ./data
DATA_PATH=/mnt/dietpi_userdata/apps/steamtrades/data

# Puertos expuestos en el Host
FRONTEND_PORT=8333
BACKEND_PORT=8334

# Parámetros de mercado por defecto
DEFAULT_TF2_STEAM_PRICE=2.02
DEFAULT_TF2_CASH_PRICE=1.62
DEFAULT_STEAM_FEE_PERCENT=13.03
