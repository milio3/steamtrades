# Configuración de ruta persistente para datos (SQLite y JSON iniciales)
# En desarrollo local: ./data
# En producción Raspberry Pi (DietPi): /mnt/dietpi_userdata/steamtrades/data
DATA_PATH=./data

# Puertos expuestos en el host
FRONTEND_PORT=80
BACKEND_PORT=8000

# Cotización de referencia para TF2 Keys
DEFAULT_TF2_STEAM_PRICE=2.02
DEFAULT_TF2_CASH_PRICE=1.62
DEFAULT_STEAM_FEE_PERCENT=13.03
